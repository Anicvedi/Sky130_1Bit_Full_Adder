digraph "full_adder" {
label="full_adder";
rankdir="LR";
remincross=true;
n2 [ shape=octagon, label="a", color="black", fontcolor="black"];
n3 [ shape=octagon, label="b", color="black", fontcolor="black"];
n4 [ shape=octagon, label="cin", color="black", fontcolor="black"];
n5 [ shape=octagon, label="cout", color="black", fontcolor="black"];
n6 [ shape=diamond, label="g", color="black", fontcolor="black"];
n7 [ shape=diamond, label="p", color="black", fontcolor="black"];
n8 [ shape=octagon, label="sum", color="black", fontcolor="black"];
c12 [ shape=record, label="{{<p9> A|<p10> B}|$2\n$and|{<p11> Y}}",  ];
c13 [ shape=record, label="{{<p9> A|<p10> B}|$4\n$and|{<p11> Y}}",  ];
c14 [ shape=record, label="{{<p9> A|<p10> B}|$5\n$or|{<p11> Y}}",  ];
c15 [ shape=record, label="{{<p9> A|<p10> B}|$1\n$xor|{<p11> Y}}",  ];
c16 [ shape=record, label="{{<p9> A|<p10> B}|$3\n$xor|{<p11> Y}}",  ];
c13:p11:e -> c14:p10:w [color="black", fontcolor="black", label=""];
n2:e -> c12:p9:w [color="black", fontcolor="black", label=""];
n2:e -> c15:p9:w [color="black", fontcolor="black", label=""];
n3:e -> c12:p10:w [color="black", fontcolor="black", label=""];
n3:e -> c15:p10:w [color="black", fontcolor="black", label=""];
n4:e -> c13:p10:w [color="black", fontcolor="black", label=""];
n4:e -> c16:p10:w [color="black", fontcolor="black", label=""];
c14:p11:e -> n5:w [color="black", fontcolor="black", label=""];
c12:p11:e -> n6:w [color="black", fontcolor="black", label=""];
n6:e -> c14:p9:w [color="black", fontcolor="black", label=""];
c15:p11:e -> n7:w [color="black", fontcolor="black", label=""];
n7:e -> c13:p9:w [color="black", fontcolor="black", label=""];
n7:e -> c16:p9:w [color="black", fontcolor="black", label=""];
c16:p11:e -> n8:w [color="black", fontcolor="black", label=""];
}
